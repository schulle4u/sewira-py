#: app.py:145
msgid "Exiting..."
msgstr "Beenden..."

#: app.py:154
msgid "The entered directory could not be found."
msgstr "Das angegebene Verzeichnis kann nicht gefunden werden."

#: app.py:161
msgid "Available streams:"
msgstr "Verfügbare Streams:"

#: app.py:171
msgid "Exit"
msgstr "Beenden"

#: app.py:181
#, python-format
msgid "No valid stream in file %(file)s."
msgstr "Kein gültiger Stream in Datei %(file)s."

#: app.py:184
#, python-format
msgid "File %(file)s not found."
msgstr "Datei %(file)s nicht gefunden."

#: app.py:187
#, python-format
msgid "Error reading file %(filename)s: %(error)s"
msgstr "Fehler beim Lesen der Datei %(filename)s: %(error)s"

#: app.py:222
#, python-format
msgid "Error during speech output: %(error_message)s"
msgstr "Fehler während Sprachausgabe: %(error_message)s"

#: app.py:239
#, python-format
msgid "Error stopping player: %(error_message)s"
msgstr "Fehler beim Stoppen des Players: %(error_message)s"

#: app.py:246
#, python-format
msgid "Error: The player %(player_name)s cannot be found."
msgstr "Fehler: Der Player %(player_name)s kann nicht gefunden werden."

#: app.py:248
#, python-format
msgid "An error occurred: %(error_message)s"
msgstr "Ein Fehler ist aufgetreten: %(error_message)s"

#: app.py:265
#, python-format
msgid "Now playing: %(stream_name)s"
msgstr "Jetzt läuft: %(stream_name)s"

#: app.py:267
msgid "Playing..."
msgstr "Abspielen..."

#: app.py:270
#, python-format
msgid "Command: %(command)s"
msgstr "Befehl: %(command)s"

#: app.py:292
msgid "No M3U files found for autoplay."
msgstr "Keine M3U-Dateien für die automatische Wiedergabe gefunden."

#: app.py:311
#, python-format
msgid "Autoplay failed: No valid stream URL found in %(file)s."
msgstr ""
"Automatische Wiedergabe fehlgeschlagen: Keine gültige Stream-URL in %(file)s "
"gefunden."

#: app.py:313
#, python-format
msgid "Autoplay failed: Invalid menu number %(number)s."
msgstr ""
"Automatische Wiedergabe fehlgeschlagen: Ungültiger Menüeintrag %(number)s."

#: app.py:315
#, python-format
msgid "Autoplay failed: '%(number)s' is not a valid menu number."
msgstr ""
"Automatische Wiedergabe fehlgeschlagen: '%(number)s' ist keine gültige "
"Nummer im Menü."

#: app.py:321
#, python-format
msgid "Directory does not exist: %(directory)s"
msgstr "Das Verzeichnis existiert nicht: %(directory)s"

#: app.py:332
#, python-format
msgid "No M3U files found in %(directory)s."
msgstr "Keine M3U-Dateien im Verzeichnis %(directory)s."

#: app.py:344
msgid "Program number (0 to exit): "
msgstr "Sendernummer (0 zum Beenden): "

#: app.py:348
msgid "Bye!"
msgstr "Tschüs!"

#: app.py:364
#, python-format
msgid "No valid stream URL found in %(file)s."
msgstr "Keine gültige Stream-URL in %(file)s gefunden."

#: app.py:366
msgid "Invalid selection."
msgstr "Ungültige Auswahl."

#: app.py:368
msgid "Please enter a valid number."
msgstr "Bitte gib eine gültige Nummer ein."
